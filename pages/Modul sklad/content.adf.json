            "localId": "b83632af-f371-4dae-908f-f6bbf8386149"
          },
          "content": [
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
                "width": 635,
                "widthType": "pixel"
              },
              "content": [
                {
                  "type": "media",
