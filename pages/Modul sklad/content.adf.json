            "localId": "957574ca-a941-4fb3-961b-f89e58aa78da",
            "height": 255
          }
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info",
        "localId": "0f3f811b-4821-4fd3-b0b5-16a3fa8d274e"
      },
      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "localId": "da296118-3f5f-4163-a1b4-e8fd269e8538"
          },
          "content": [
            {
              "text": "Typ ",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "localId": "812bceee-ed11-4134-b654-a7f9d30b70c7"
          },
          "content": [
            {
              "text": "Volný prodej ",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": "jsou očkovací látky, které nespadají do povinného očkování. Jedná se o volitelné očkování, které ale může pojišťovna plně nebo částečně hradit.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "localId": "393b702b-f897-4918-9f73-7a3f62238140"
          },
          "content": [
            {
              "text": "Látky hrazení státem (clearingové centrum)",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": " zahrnuje očkovací látky, které metodika označuje jako povinné, resp. pravidelné očkování.",
              "type": "text"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "localId": "26c5488b-8ff5-486f-94cb-1f64fe06daba"
          },
          "content": [
            {
              "text": "Zvláštní látky",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": " zahrnují očkování proti hepatitidě A, hepatitidě B, proti vzteklině a proti Covid-19 tak je je specifikuje ",
              "type": "text"
            },
            {
              "text": "Vyhláška o očkování proti infekčním nemocem",
              "type": "text",
              "marks": [
                {
                  "type": "em"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "localId": "73abdc09-88d7-4753-a682-ea0be05cc0ac"
          },
          "content": [
            {
              "text": "č. 537/2006 Sb., konkrétně §9, §10 a §11.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "505c750a-55a1-4734-a5a8-1643b924842d"
      },
      "content": [
        {
          "text": "V případě, že není naskladňován celý balíček očkovací látky, je možné zadat i jiný počet dávek, než jsou v originálním balení. Políčko typ udává, zda je očkovací látka vykazována standardně na pojišťovnu nebo je hrazena mandatorně (státem). V případě, že se lékař překlepne v šarži látky nebo udělá nějakou jinou chybu, je možné očkovací látku smazat tlačítkem „Smazat nepoužitou šarži“. Toto tlačítko bude neaktivní ve chvíli, kdy již nějaká vakcína této šarže byla aplikována. Pokud bude třeba naskladnit další vakcíny stejné šarže, stačí kliknout na tlačítko „Naskladnit“ vedle názvu šarže. Naopak, pokud bude třeba z nějakého důvodu (např. prošlá expirace, rozbitá lednice,…) odstranit ze skladu vakcíny nějaké šarže, je třeba kliknout na tlačítko „Vyskladnit“. Toto tlačítko slouží k hromadnému vyskladnění očkovací látky. Po aplikaci očkovací látky pacientovi a zadání očkování do programu je příslušná vakcína rovnou ze skladu odepsána. Při kliknutí na danou šarži je vidět pohyb na její skladové kartě.  ",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "5c6c50d0-bc55-4722-aad4-74b165f864a7"
      },
      "content": [
        {
          "text": "Pozn. Aby bylo možné využívat sklad, je nutné ho mít povolen u uživatele v Organizační struktuře a nadefinován na pracovišti.",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " ",
          "type": "text"
        }
      ]
    },
