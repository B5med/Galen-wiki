    },
    {
      "type": "heading",
      "attrs": {
        "level": 3,
        "localId": "7b8b6b0d1060"
      },
      "content": [
        {
          "text": "Pokladní doklady ",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "7e9fae91216c"
      },
      "content": [
        {
          "text": "V sekci Pokladní doklady lze filtrovat a tisknout zavedené pokladní doklady. Horní část okna zobrazuje jednotlivé doklady a po označení požadovaného řádku s pokladním dokladem se v dolní části okna zobrazuje obsah dokladu, tedy položky na dokladu uvedené. ",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 1271,
            "alt": "image-20250619-073032.png",
