        {
          "text": "Měna",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " zvolí, zda je pokladna vedena v Kč, nebo v EUR. Pokladnu, na které už jsou doklady, nelze převést na jinou měnu. V seznamech se pokladna v EUR zobrazuje s označením měny (např. „Pokladna recepce | EUR“).",
          "type": "text"
        }
      ]
    },
