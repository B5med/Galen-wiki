        {
          "text": "Ceník",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " sloupec ",
          "type": "text"
        },
        {
          "text": "Měna",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": ", ve kterém se u každé ceny zvolí Kč nebo EUR. Stejná položka sortimentu může mít současně platnou cenu v Kč i v EUR.",
          "type": "text"
        }
