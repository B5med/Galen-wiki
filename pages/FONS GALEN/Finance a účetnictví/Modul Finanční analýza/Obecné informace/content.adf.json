          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Po aktivaci modulu je potřeba počkat do následujícího dne, než budou data a vstupní údaje k dispozici.",
                  "type": "text"
                }
              ]
            }
