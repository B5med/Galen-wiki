        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "7cbb9dc0c0ec"
      },
      "content": [
        {
          "text": "V kartotéce po označení pacienta stiskem tlačítka objednat otevřeme definované kalendáře, do kterých lze pacienta objednat dvojklikem do okénka příslušného času, kdy se objeví okno objednávky.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
