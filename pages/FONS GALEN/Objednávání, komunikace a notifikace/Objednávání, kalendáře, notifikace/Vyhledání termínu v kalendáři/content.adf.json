    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "17a449a289f7"
      },
      "content": [
        {
          "text": "Při vyhledávání lze ovlivnit, co systém považuje za „obsazený\" slot, pomocí parametru:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
