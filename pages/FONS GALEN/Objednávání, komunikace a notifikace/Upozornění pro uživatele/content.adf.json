          "attrs": {
            "localId": "c0e62ca1aeec"
          },
          "content": [
            {
              "text": "Indikace nepřečtených oznámení",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "027ff81cbec1"
      },
      "content": [
        {
          "text": "Seznam upozornění po kliku na ikonu oznámení. Po kliku na záznam se otevře okno bočního",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "panelu, kde je možné s upozorněním pracovat.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 1107,
            "alt": "image-20250709-135617.png",
            "id": "815fb501-aba7-400a-b4f5-2c1298cd027c",
            "collection": "contentId-67305473",
            "type": "file",
            "localId": "f5a043370cd7",
            "height": 317
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "6cdf64ac4903"
      },
      "content": [
        {
          "text": "c. V kontextovém menu nad kartou pacienta.",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Kontextové menu je vyvolané pravým tlačítkem myši. Upozornění takto vznikne s vazbou na",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Pacienta.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 1007,
            "alt": "image-20250709-135643.png",
            "id": "b5984738-56c0-404f-85f1-4bf86e6abfd2",
            "collection": "contentId-67305473",
            "type": "file",
            "localId": "1ee0a2685af4",
            "height": 566
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "82cbeab2c4da"
      },
      "content": [
        {
          "text": "Jak vytvořím nové upozornění?",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Upozornění je možné vytvořit po kliku na tlačítko + buď z hlavního bočního panelu, nebo ze",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "seznamu upozornění. Následně se uživateli otevře okno, kde je možné vyplnit obsah upozornění.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 614,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 614,
            "alt": "image-20250709-135808.png",
            "id": "303d3f6e-e09d-4c3f-a2ae-994970838079",
            "collection": "contentId-67305473",
            "type": "file",
            "localId": "214414a06397",
            "height": 482
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "6cafc4b7aef4"
      }
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "3539fa6bc5b6"
      },
      "content": [
        {
          "text": "Popis jednotlivých položek",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "localId": "ec009aebd531",
        "order": 1
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "16bbc69ed98d"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "0249420c626f"
              },
              "content": [
                {
                  "text": "Kategorie",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Je nutné předdefinovat v module Nástroje, okno Šablony (popsáno níže).",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Po zvolení doplní automaticky pole Nadpis a Obsah upozornění.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ccbd4eda53b9"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "1896f14bf300"
              },
              "content": [
                {
                  "text": "Nadpis",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Hlavní popis upozornění, v bočním panelu je zvýrazněn.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "d2d43a846402"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "a054e378cde9"
              },
              "content": [
                {
                  "text": "Obsah",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Podrobný popis upozornění.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ec24586a0230"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "ad4df3d44477"
              },
              "content": [
                {
                  "text": "Adresát",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Výběr adresátů, uživatelů, kterým bude toto upozornění doručeno (popsáno níže). Přednastavený výběr je „Osobní“.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "59b107798f69"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "2053dcce041e"
              },
              "content": [
                {
                  "text": "Název adresáta",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Sumarizující popis skupiny adresátů. Slouží jako informace pro adresáty, kde je vidět komu je tato informace určená, například: jenom pracoviště XY, jenom sestry. Pole je nepovinné a NESLOUŽÍ jako výběr adresátů!",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "62f62d6edcd9"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "c178dfbd2d3a"
              },
              "content": [
                {
                  "text": "Vybraní uživatelé",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Stavová informace o tom, kteří uživatelé byli vybráni.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "eba50f56cddb"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "a4a385f956e8"
              },
              "content": [
                {
                  "text": "Pacient",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Upozornění je možné přiradit až 10 pacientům. Pacientovi, pokud existuje, se automaticky doplní kontaktní údaj. Adresát upozornění následně obdrží informaci, zda se upozornění váže na konkrétního pacienta a viz. Obrázek 1 (upozornění ",
                  "type": "text"
                },
                {
                  "text": "„Přeobjednat pacienta“",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": ") má tuto informaci ihned zobrazenou a dokáže se jedním klikem dostat do dekurzu daného pacienta.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "edd463caba04"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "1772191f11a4"
              },
              "content": [
                {
                  "text": "Splnění",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Je možné vybrat z dvou hodnot:",
                  "type": "text"
                }
              ]
            },
            {
              "type": "orderedList",
              "attrs": {
                "localId": "e6b1ced3e8ca",
                "order": 1
              },
              "content": [
                {
                  "type": "listItem",
                  "attrs": {
                    "localId": "9bdc75662b82"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "localId": "7032bfb11484"
                      },
                      "content": [
                        {
                          "text": "Kdokoliv – Aby bylo upozornění splněno, stačí, aby ho splnil jenom 1 adresát.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "attrs": {
                    "localId": "ea48f48a4fde"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "localId": "862fa800dbf3"
                      },
                      "content": [
                        {
                          "text": "Všichni – Aby bylo upozornění splněno, musí ho splnit každý adresát.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "bff7a65026a3"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3406b97511cc"
              },
              "content": [
                {
                  "text": "Priorita",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Je možné vybrat 3 priority upozornění.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "orderedList",
              "attrs": {
                "localId": "d409ad82a23c",
                "order": 1
              },
              "content": [
                {
                  "type": "listItem",
                  "attrs": {
                    "localId": "ac2be6767091"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "localId": "39b74c3ab4ca"
                      },
                      "content": [
                        {
                          "text": "Standardní – Zobrazí se až po otevření bočního panelu. Bez vizuálního označení.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "attrs": {
                    "localId": "70da6cde521b"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "localId": "13d428ee4e70"
                      },
                      "content": [
                        {
                          "text": "Důležitá – Boční panel s upozorněním se zobrazí po zapnutí Galenu a otevření libovolného modulu. Vizuálně je označena 1 vykřičníkem.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "attrs": {
                    "localId": "e21ed1cbce19"
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {
                        "localId": "783f66d3ccb1"
                      },
                      "content": [
                        {
                          "text": "Urgentní – Boční panel s upozorněním se zobrazí ihned. Vizuálně je označena 2 vykřičníky.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "aadd5e422386"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "cf1b9e1438ba"
              },
              "content": [
                {
                  "text": "Termín",
                  "type": "text"
                },
                {
                  "type": "hardBreak"
                },
                {
                  "text": "•Je možné si určit termín splnění. Po překročení termínu se boční panel zobrazí. Následně po každém zapnutí Galenu dokud nebude upozornění splněno, nebo stornováno.",
                  "type": "text"
                }
              ]
            }
          ]
