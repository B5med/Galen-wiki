    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "bf8f262a821e"
      },
      "content": [
        {
          "text": "b. Po kliku na stávající ikonu oznámení.",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Na ikoně oznámení je počet nepřečtených echo zpráv a upozornění dohromady. V tooltipu je vidět",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "rozdělení nepřečtených informací.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
