  "content": [
    {
      "type": "paragraph",
      "attrs": {
        "localId": "a8ba80ccb726"
      },
      "content": [
        {
          "text": "K čemu slouží funkcionalita upozornění pro uživatele?",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "3efd27f238c3"
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "26efdf11e657"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "5091a08c6794"
              },
              "content": [
                {
                  "text": "Upozornění je možné použít k různím účelům, například:",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "c41a1b30059f"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "fad6e26d3878"
              },
              "content": [
                {
                  "text": "Osobní To-Do list.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "c88e2a9398cd"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "83314e16dd1f"
              },
              "content": [
                {
                  "text": "Zaznamenání důležitých úloh/událostí.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ae132eb0ca36"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "0750dff6e2c3"
              },
              "content": [
                {
                  "text": "Sdělování informací mezi uživateli mezi pracovišti, společností nebo mezi recepcí a ordinací.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "559f71679bb0"
      },
      "content": [
        {
          "text": "Kdo může tuto funkcionalitu využívat?",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "b78f5b659ff1"
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "4e90ba091ea7"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "1d273c72a168"
              },
              "content": [
                {
                  "text": "Funkcionalitu může používat každý uživatel bez ohledu na jeho roli. Role má vliv jenom na možnost odesílat upozornění na různé množiny uživatelů, případně její editaci.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "fec7dab22a86"
      },
      "content": [
        {
          "text": "Kde najdu tuto funkcionalitu?",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "8ace1b6c1eea"
      },
      "content": [
        {
          "text": "K upozorněním je možné se dostat dvěma cestami:",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "43b630387aa4"
      },
      "content": [
        {
          "text": "a. Klávesovou zkratkou F3.",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "0033514cd362"
      },
      "content": [
        {
          "text": "Po jejím stisknutí se uživateli vysune panel s upozorněními, viz. obrázek .",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 320,
        "widthType": "pixel"
      },
