            "height": 480
          }
        },
        {
          "type": "caption",
          "content": [
            {
              "text": "Panel upozornění pro uživatele",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Popis záložek:",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Pro mě – Všechna upozornění, kde jsem uveden jako adresát.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Ode mě – Všechna upozornění, jejichž jsem autor.",
          "type": "text"
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Splněné – Všechna splněná nebo stornovaná upozornění.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
