    {
      "type": "paragraph",
      "content": [
        {
          "text": "Další okna odklikat pomocí ",
          "type": "text"
        },
        {
          "text": "Next ",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": "a poslední pomocí ",
          "type": "text"
        },
        {
          "text": "Install",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "(2) Vyexportování certifikátu z úložiště",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " ",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Pomocí tlačítka ",
          "type": "text"
        },
        {
          "text": "Start ",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": "na hlavním panelu Windows a vepsáním textu ",
          "type": "text"
        },
        {
          "text": "certmgr.msc",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " a potvrzení enterem je možné zobrazit certifikáty nainstalované v úložišti. ",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 340,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 340,
            "alt": "image-20250901-085737.png",
            "id": "a5508ab1-d091-45c4-8547-5f45082cd81a",
            "collection": "contentId-109215766",
            "type": "file",
            "height": 711
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Zde je zapotřebí vybrat certifikát, který má být opraven a ten vyexportovat. ",
          "type": "text"
        }
      ]
    },
