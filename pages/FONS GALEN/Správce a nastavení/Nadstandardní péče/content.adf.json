                    "alt": "image-20250619-100715.png",
                    "id": "86dbbc81-5ed8-4aa0-a11d-58564e8e8b88",
                    "collection": "contentId-50495507",
                    "type": "file",
                    "height": 215
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "layoutColumn",
          "attrs": {
