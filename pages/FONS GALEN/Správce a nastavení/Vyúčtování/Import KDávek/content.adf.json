              },
              "content": [
                {
                  "text": "Rozpracovaný ",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "3e125bf2a511"
          },
          "content": [
            {
