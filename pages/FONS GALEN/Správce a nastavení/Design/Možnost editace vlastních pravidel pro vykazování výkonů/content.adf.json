                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": "- výkony nebude možné v rámci definovaného období společně vykázat",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
