    {
      "type": "paragraph",
      "attrs": {
        "localId": "8aac4296a7d1"
      },
      "content": [
        {
          "text": "V definici svázaných výkonů, které se vykazují z vyšetření, je možné zadat podmínky, za kterých bude svázaný výkon vykázán.",
