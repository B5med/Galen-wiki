              },
              "content": [
                {
                  "text": "Hlavní nebo řádková diagnóza",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – kombinace je zakázaná, shoduje-li se hlavní nebo řádková diagnóza",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "642fb55b27ea"
      },
      "content": [
        {
          "text": "Zakázat výkony",
