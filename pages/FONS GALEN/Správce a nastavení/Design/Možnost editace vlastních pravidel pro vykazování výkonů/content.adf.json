    {
      "type": "paragraph",
      "attrs": {
        "localId": "dc7fd37ef54e"
      },
      "content": [
        {
          "text": "Pokud není definován hlavní výkon, funguje pravidlo jinak, než je uvedeno výše. Pokud jsou definovány pouze výkony bez výkonu hlavního, funguje pravidlo tak, že v daný časový úsek není možné zde uvedené výkony vykázat současně.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 369,
        "widthType": "pixel"
      },
      "content": [
