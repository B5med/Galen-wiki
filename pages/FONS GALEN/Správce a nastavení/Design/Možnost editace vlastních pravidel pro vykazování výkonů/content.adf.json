      "attrs": {
        "localId": "02521a890190"
      },
      "content": [
        {
          "text": "Hlavní výkon definuje podmínku, kdy v případě, že je v daném časovém období daný výkon vykázán, tak je dále v časovém období možné vykázat pouze výkony dále definované.",
          "type": "text"
        }
      ]
    },
