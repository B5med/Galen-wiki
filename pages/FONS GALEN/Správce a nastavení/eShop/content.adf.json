      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "1356cc35c300"
      }
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "4acd90af0d53"
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "422bdf0ce6a9"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d3c81e88c7f9"
              },
              "content": [
                {
                  "text": "Objednanou funkcionalitu je potřeba zprovoznit pracovníkem Stapro. Pracovník Stapro je o objednávce informován a spojí se s objednatelem, aby se domluvili na dalším postupu.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "mediaSingle",
