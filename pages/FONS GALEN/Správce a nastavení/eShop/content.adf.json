        "localId": "508b2ae4f559",
        "order": 4
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "ba9df7bbb19d"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "8fc04e58b91a"
              },
              "content": [
                {
                  "text": "Stav své objednávky může uživatel sledovat v záložce Objednávky ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "mediaSingle",
              "attrs": {
