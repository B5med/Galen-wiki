              "type": "paragraph",
              "attrs": {
                "localId": "b5cd93a9168a"
              },
              "content": [
                {
                  "text": "Přehled dostupných funkcionalit a doplňkových modulů k FONS Galen",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "37744bd2-56d4-4be5-aab8-dace7d1ad9b1"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "f27e75bc1db7"
              },
              "content": [
                {
                  "text": "Stručný popis přínosu a fungování každé položky",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
