          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "5cfb9f0972f9"
              },
              "content": [
                {
                  "text": "Přijde Vám e-mail s potvrzením přijetí žádosti.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "0d7eae1600a3"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "5cee7289105e"
              },
              "content": [
                {
                  "text": "Po schválení Vám přijde e-mail s PDF „Změna pravidelné fakturace“, při zamítnutí e-mail s důvodem zamítnutí.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "27b312048565"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "99c99e50dbb2"
              },
              "content": [
                {
                  "text": "Stav žádosti je vidět u funkcionality na stránce ",
                  "type": "text"
                },
                {
                  "text": "Přehled",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": ", např. „Žádost o snížení na 3× čeká na schválení“ nebo „Aktuálně 5×, od 1. 2. 2027 3×“.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ac6565c9d283"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "42620e86a71c"
              },
              "content": [
                {
                  "text": "U jedné funkcionality může být rozpracovaná vždy jen jedna žádost.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "f18a9aed53af"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "b4c2a96fcc3f"
              },
              "content": [
                {
                  "text": "Funkcionalitu nelze zrušit, pokud ji vyžaduje jiná aktivní funkcionalita. ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
