              },
              "content": [
                {
                  "text": "Na stránce ",
                  "type": "text"
                },
                {
                  "text": "Přehled ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": "zvolené funkcionality vložíte do košíku",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
