      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "localId": "bdcf4f424bef"
          },
          "content": [
            {
              "text": "Snížení počtu je žádost o změnu smluvních podmínek. Platí až po schválení obchodním zástupcem, nejdříve od začátku dalšího fakturačního období. Za již uhrazené období se platba nevrací.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "6d8d931e1969"
      },
      "content": [
        {
          "text": "Po odeslání žádosti:",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "020c8c3fee09"
      },
      "content": [
        {
          "type": "listItem",
