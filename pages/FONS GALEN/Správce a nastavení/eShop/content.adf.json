              "attrs": {
                "localId": "1544fcc14e2d"
              },
              "content": [
                {
                  "text": "Cenu a možnost rovnou zadat objednávku",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "d8c1d981-d02b-4aba-8d0d-d7485d654dac"
          },
          "content": [
            {
              "type": "paragraph",
