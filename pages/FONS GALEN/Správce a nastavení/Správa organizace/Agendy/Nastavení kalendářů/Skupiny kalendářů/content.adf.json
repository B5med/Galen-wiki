        },
        {
          "text": "Volné dny",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Lze nastavit volno na celý den nebo pouze vybraný čas.",
          "type": "text"
        }
      ]
    },
