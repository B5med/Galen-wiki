          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "810c1c272565"
              },
              "content": [
                {
                  "text": "Klikněte na tlačítko Nastavit.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "a3fdf0a6e69e"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "63641bf1feff"
              },
              "content": [
                {
                  "text": "V systémovém dialogu Windows zvolte certifikát určený pro klientskou autentizaci (Client Authentication, mTLS).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "19ef612cc800"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "628c6f27ce08"
              },
              "content": [
                {
                  "text": "Potvrďte výběr. Systém nahraje certifikát a zobrazí jeho identifikaci a datum platnosti.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
