          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "785e57f0555e"
              },
              "content": [
                {
                  "text": "Certifikát – pole zobrazující nahraný certifikát.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "3806443d4f9a"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "6a5fbb2a1881"
              },
              "content": [
                {
                  "text": "Datum vygenerování  – datum nahrání certifikátu.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ab989ae79ffe"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d716f21d9125"
              },
              "content": [
                {
                  "text": "Platnost do – datum vypršení platnosti certifikátu.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "e67791b06cb3"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "e0235d6dc457"
              },
              "content": [
                {
                  "text": "Tlačítko Nastavit – slouží k nahrání certifikátu.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "d615209be807"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "2f9774c0f1bb"
              },
              "content": [
                {
                  "text": "Jen povolené IP adresy – omezení přístupu na vybrané IP adresy.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3,
        "localId": "e6b25b537851"
      },
      "content": [
        {
          "text": "Nahrání certifikátu – postup",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
