            "alt": "image-20251210-150946.png",
            "id": "0f2ad1ff-3940-4ae8-aaf6-b7da6181b792",
            "collection": "contentId-193363969",
            "type": "file",
            "localId": "46b19531-d199-4375-8aba-e2974e55ee48",
