                      "text": "Pracoviště ",
                      "type": "text"
                    },
                    {
                      "text": "mimo",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    },
                    {
                      "text": " odbornosti 001, 002 a 603, na kterém má pacient vykázán alespoň jeden výkon.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "a690d34a33c1"
      },
      "content": [
        {
          "text": "Chování při chybějícím pracovišti",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "e345305122cd"
      },
      "content": [
        {
          "type": "listItem",
