          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "019dbf8b73a8"
              },
              "content": [
                {
                  "text": "Pokud pacient ",
                  "type": "text"
                },
                {
                  "text": "nemá žádné registrující (kapitační) pracoviště",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ", informace o tom se na kartotéce pacienta přesto ",
                  "type": "text"
                },
                {
                  "text": "vypíše",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " (zobrazí se text/stav upozorňující, že pacient nemá platnou registraci).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "b7f6cf240893"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "08953490ce26"
              },
              "content": [
                {
                  "text": "Pokud pacient ",
                  "type": "text"
                },
                {
                  "text": "nemá žádné evidující pracoviště",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ", celá sekce s evidujícími pracovišti se u daného pacienta ",
                  "type": "text"
                },
                {
                  "text": "vůbec nezobrazí",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "f29b7504fc6f"
      },
      "content": [
        {
          "text": "Nastavení zobrazení",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "8b216e363eae"
      },
      "content": [
        {
          "text": "Zobrazení registrujících a evidujících pracovišť lze nezávisle zapnout/vypnout na dvou úrovních:",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3,
        "localId": "b6ef12fe6739"
      },
      "content": [
        {
          "text": "1. Na úrovni společnosti",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "0a27f6e684a7"
      },
      "content": [
        {
          "text": "Přístup: ",
          "type": "text"
        },
        {
          "text": "Konfigurace společnosti → záložka Info panel pacienta (Recepce)",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "0e6efe839579"
      },
      "content": [
        {
          "text": "Zde je možné u volby zobrazení nastavit, zda se mají registrující a evidující pracoviště zobrazovat pro celou společnost.",
          "type": "text"
        }
      ]
    },
