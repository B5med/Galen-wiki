      },
      "content": [
        {
          "text": "Volba ",
          "type": "text"
        },
        {
          "text": "Sbalit",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " se zobrazuje v každé sekci. Pokud je checkbox zaškrtnut, bude sekce ve výchozím zobrazení info panelu sbalena. Uživatel ji klikem může rozbalit. ",
          "type": "text"
        }
      ]
