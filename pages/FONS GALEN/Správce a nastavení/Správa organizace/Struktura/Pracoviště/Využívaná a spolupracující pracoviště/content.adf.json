    {
      "type": "heading",
      "attrs": {
        "level": 3,
        "localId": "674b07cdd8a6"
      },
      "content": [
        {
          "text": "Spolupracující pracoviště",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "36914321dde9"
      },
      "content": [
        {
          "text": "Pokud je na stejné společnosti více pracovišť se stejnou specializací, je možné po stisku tlačítka ",
          "type": "text"
        },
        {
          "text": "Spolupracující … ",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " nastavit spolupracující pracoviště se stejnou specializací. Spolupracující pracoviště mají většinou možnost nahlížet na stejnou frontu entit, případě si entity mezi sebou přepínat.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "7385ed540b15"
      },
      "content": [
        {
          "text": "Využívaná pracoviště",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "bb9f84e04269"
      },
      "content": [
        {
          "text": "Pokud je na společnosti alespoň jedno pracoviště opatřené příznakem specializovaného pracoviště, na ostatních pracovištích je zobrazeno tlačítko ",
          "type": "text"
        },
        {
          "text": "Využívaná pracoviště.",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
