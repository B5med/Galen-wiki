          }
        },
        {
          "type": "caption",
          "attrs": {
            "localId": "990b099b23f0"
          },
          "content": [
            {
              "text": "Toto pracoviště může vystavovat RDG žádanky na tři ze čtyř RDG pracovišť v rámci společnosti. Při vystavení konkrétní žádanky tak uživatel volí, na které pracoviště RDG žádanku odešle.",
              "type": "text"
            }
          ]
        }
      ]
