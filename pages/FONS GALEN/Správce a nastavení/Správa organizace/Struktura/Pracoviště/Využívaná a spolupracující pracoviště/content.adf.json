    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "221ae688c7c3"
      },
      "content": [
        {
          "text": "Znamená to, že toto pracoviště může využívat toto specializované pracoviště, např.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 338,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
