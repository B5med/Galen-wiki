          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "effed8d03f89"
              },
              "content": [
                {
                  "text": "výkon prohlídky: ",
                  "type": "text"
                },
                {
                  "text": "„Výkon {kód} lze zadat pouze prostřednictvím modulu prohlídek“",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "2f6524f876bb"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "021479829459"
              },
              "content": [
                {
                  "text": "výkon očkování: ",
                  "type": "text"
                },
                {
                  "text": "„Výkon očkování není možné zadat přímo“",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
