{
  "type": "doc",
  "content": [
    {
      "type": "paragraph",
      "attrs": {
        "localId": "d078ab57b7f1"
      },
      "content": [
        {
          "text": "Správce může nastavit, že vybrané výkony očkování a preventivních prohlídek nepůjde zadat přímo v editoru výkonů. Vykážou se jen automaticky po zadání očkování, nebo ručně z modulu prohlídek.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "81bef2ec22db"
      },
      "content": [
        {
          "text": "Nastavení",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "localId": "58927e15c9cb",
        "order": 1
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "47ebe4c8f60e"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "bf951898755d"
              },
              "content": [
                {
                  "text": "V okně ",
                  "type": "text"
                },
                {
                  "text": "Konfigurace společnosti",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " na záložce ",
                  "type": "text"
                },
                {
                  "text": "Konfigurace",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " zaškrtněte volbu ",
                  "type": "text"
                },
                {
                  "text": "Omezení přímého zadávání výkonů",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "236101893705"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d28ffeb6db3d"
              },
              "content": [
                {
                  "text": "Klikněte na tlačítko ",
                  "type": "text"
                },
                {
                  "text": "Upřesnit",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " vedle volby.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "f7776f958237"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "17d7ac00f1de"
              },
              "content": [
                {
                  "text": "V dialogu ",
                  "type": "text"
                },
                {
                  "text": "Upřesnit omezení zadávání výkonů",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " nechte zaškrtnuté výkony, které se mají omezit. Výkony, které má jít dál zadávat přímo, odškrtněte.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "2176e7a02119"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "a15ca3062607"
              },
              "content": [
                {
                  "text": "Potvrďte OK a uložte konfiguraci společnosti.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "259371a9742e"
      },
      "content": [
        {
          "text": "Seznam nabízí všechny výkony očkování a všechny výkony definované na preventivních prohlídkách. Ve výchozím stavu jsou zaškrtnuté všechny. Po najetí myší na volbu se zobrazí přehled výkonů, kterých se omezení právě týká.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 692,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 692,
            "alt": "image-20261105-082004.png",
            "id": "8548fa2a-f3a3-4ff9-9ee9-bcfe46ae8192",
