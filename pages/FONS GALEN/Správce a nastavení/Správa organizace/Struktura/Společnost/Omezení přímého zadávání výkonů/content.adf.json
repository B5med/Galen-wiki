          }
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "0ec911604199"
      },
      "content": [
        {
          "text": "Kdy se omezení uplatní u prohlídek",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "fc9869a17722"
      },
      "content": [
        {
          "text": "U výkonů prohlídek musí platit obě podmínky:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "d31e2a476330"
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "52ba6170d38d"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "52c9aa3b4213"
              },
              "content": [
                {
                  "text": "výkon je v dialogu ",
                  "type": "text"
                },
                {
                  "text": "Upřesnit",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " zaškrtnutý,",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "87c643a1f44f"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "cdc2f5eaaa7c"
              },
              "content": [
                {
                  "text": "výkon je definovaný na prohlídce, která je zveřejněná pro odbornost a pracoviště, na kterém se vykazuje.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "00a653a7626f"
      },
      "content": [
        {
          "text": "Pokud má prohlídka nastavené ",
          "type": "text"
        },
        {
          "text": "Omezit pro odbornost",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": ", omezení platí jen na pracovištích s touto odborností. Více na stránce ",
          "type": "text"
        },
        {
          "text": "Prohlídky",
          "type": "text",
          "marks": [
            {
              "type": "link",
              "attrs": {
                "href": "https://stapro-galen.atlassian.net/wiki/spaces/fg/pages/50102315"
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "2e247528fee4"
      },
      "content": [
        {
          "text": "Hlášky v editoru výkonů",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "0f562ce16657"
      },
      "content": [
        {
          "type": "listItem",
