            "type": "file",
            "height": 244
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Uživatelé mají možnost změnit barvu standardní a výběrové šablony výkonů. Šablonu výkonů. Lze nadefinovat z nabízené množiny barev barvu tlačítka šablony. ",
          "type": "text"
        }
      ]
    }
  ],
  "version": 1
}
