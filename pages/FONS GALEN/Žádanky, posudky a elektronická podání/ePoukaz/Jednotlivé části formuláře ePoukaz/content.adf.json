          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "9545ec33-46f7-44a2-afbf-90eea74037c6"
              },
              "content": [
                {
                  "text": "Následně je nutné vyplnit příslušné položky a výsledek stiskem tlačítka Odeslat odeslat na SÚKL.",
                  "type": "text"
                }
              ]
            }
          ]
