              "attrs": {
                "localId": "93c4144d2982"
              },
              "content": [
                {
                  "text": "Uživatel provede potřebné úpravy a tlačítkem ",
                  "type": "text"
                },
                {
                  "text": "Opravit",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " odesílá změny. ",
                  "type": "text"
                }
              ]
            },
