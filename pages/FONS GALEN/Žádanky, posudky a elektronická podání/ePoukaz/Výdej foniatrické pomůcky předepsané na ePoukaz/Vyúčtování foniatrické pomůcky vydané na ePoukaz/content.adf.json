            {
              "type": "paragraph",
              "attrs": {
                "localId": "64fe6fd8050a"
              },
              "content": [
                {
                  "text": "Zrušením výdeje se ePoukaz dostane do stavu ",
                  "type": "text"
                },
                {
                  "text": "Předepsaný. ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": "Pomocí volby ",
                  "type": "text"
                },
                {
                  "text": "Opravit ePoukaz",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " uživatel převede ePoukaz do editačního módu a provede potřebné úpravy.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
                "width": 679,
                "widthType": "pixel"
