              "attrs": {
                "localId": "7a131230ecec"
              },
              "content": [
                {
                  "text": "Uživatel na ePoukazu zruší výdej ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
