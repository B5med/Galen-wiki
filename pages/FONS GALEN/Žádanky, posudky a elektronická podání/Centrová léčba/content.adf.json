          },
          "content": [
            {
              "text": "Centrová léčba",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "rule",
      "attrs": {
        "localId": "a87da50777c0"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "59afeb31f574"
      },
      "content": [
        {
          "text": "Zahájení nové léčby pacienta",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "localId": "e2db853374f2",
        "order": 1
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "75143a669bf3"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d4df33912c73"
              },
              "content": [
                {
                  "text": "V záložce Léčby klikněte na tlačítko pro přidání nové léčby.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ad4e588e55d4"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "2d033333ea53"
              },
              "content": [
                {
                  "text": "Vyplňte základní informace: vyberte pacienta, zadejte diagnózu, vyberte léčivo z číselníku, zvolte příslušný paragraf.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "6bdc73b5e9e4"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "6b8253edc30c"
              },
              "content": [
                {
                  "text": "Nastavte datum zahájení léčby.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "3aa9542872e6"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "a4c9c10782b3"
              },
              "content": [
                {
                  "text": "Uložte novou léčbu. Systém ověří, zda pro daného pacienta a léčivo již neexistuje aktivní léčba.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "8e8703a2a7ad"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "263b6a609cf9"
              },
              "content": [
                {
                  "text": "Po uložení se nová léčba zobrazí v přehledu.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
