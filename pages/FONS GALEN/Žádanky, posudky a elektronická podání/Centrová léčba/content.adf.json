{
  "type": "doc",
  "content": [
    {
      "type": "panel",
      "attrs": {
        "panelType": "info",
        "localId": "ca77c6a7479c"
      },
      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "localId": "61a246379615"
          },
          "content": [
            {
              "text": "Modul Centrová léčba slouží k evidenci, správě a povinnému elektronickému hlášení dat o indikacích a podáváních inovativních léčivých přípravků v rámci tzv. centrové léčby. ",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "localId": "2ab9eeceeba8"
          },
          "content": [
            {
              "text": "Tato povinnost vyplývá z požadavků Ústavu zdravotnických informací a statistiky ČR (ÚZIS) a je legislativně závazná pro všechna pracoviště, která smluvně poskytují centrovou léčbu.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "e26df2753453"
      },
      "content": [
        {
          "text": "Modul umožňuje:",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "462b9ca8ef10"
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "6462e4db8cc7"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "cd817d3e6631"
              },
              "content": [
                {
                  "text": "evidovat léčby pacientů – zahájení, průběh, ukončení;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "e6766d1ac5ec"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "c66f9d21e2a0"
              },
              "content": [
                {
                  "text": "zaznamenávat jednotlivá podání léčiva;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "537ea8fe7fe3"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d30ba7783f30"
              },
              "content": [
                {
                  "text": "sledovat stav každého podání;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "bccd03a57444"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "8077d68aface"
              },
              "content": [
                {
                  "text": "automaticky vykazovat výkon (kód 99991) po odeslání podání;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "75d047088b87"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3215c583151a"
              },
              "content": [
                {
                  "text": "filtrovat a přehledně zobrazovat seznam léčeb a podání;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "54727988ec16"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3c00736123b0"
              },
              "content": [
                {
                  "text": "procházet historii změn u každé léčby.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "rule",
      "attrs": {
        "localId": "5de79160c63a"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3,
        "localId": "a5add62e6b7e"
      },
      "content": [
        {
          "text": "Kdy funkci použít",
          "type": "text"
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info",
        "localId": "f449d8e7d398"
      },
      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "localId": "0e1280aaf205"
          },
          "content": [
            {
              "text": "Modul Centrová léčba je určen pro lékaře na pracovištích, která mají uzavřenu zvláštní smlouvu o centrové léčbě. ",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "30a963e9c8aa"
      },
      "content": [
        {
          "text": "Použijete jej ve chvíli, kdy:",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "attrs": {
        "localId": "c72f6c93a97c"
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "b3f7da52be0c"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "8a222245c9b5"
              },
              "content": [
                {
                  "text": "zahajujete u pacienta léčbu inovativním léčivým přípravkem v rámci centrové léčby;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ab119d9e6103"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "e794f55851a7"
              },
              "content": [
                {
                  "text": "aplikujete pacientovi dávku léčiva a potřebujete toto podání zaznamenat;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "fc1b0b8d34a5"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "9aae316660bf"
              },
              "content": [
                {
                  "text": "potřebujete upravit nebo ukončit probíhající léčbu (a zadat důvod změny);",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "5e1f92f4c979"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "8629bc03faa1"
              },
              "content": [
                {
                  "text": "chcete zkontrolovat stav odesílání dat na ÚZIS nebo zjistit, zda hlášení proběhlo bez chyby;",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "09f5ea1b3408"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "04110db4e0d6"
              },
              "content": [
                {
                  "text": "potřebujete rychlý přehled všech léčeb nebo podání pro celé pracoviště nebo konkrétního pacienta.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "d2e6d7de470e"
      },
      "content": [
        {
          "text": "V klinickém pracovním postupu typicky přistoupíte do modulu po ambulantní návštěvě pacienta léčeného centrovou léčbou, nebo pravidelně na konci ordinační doby, abyste zkontrolovali stavy odeslaných hlášení.",
          "type": "text"
        }
      ]
    },
    {
      "type": "rule",
      "attrs": {
        "localId": "3d5ed4c33f95"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "c3d6ae12b422"
      },
      "content": [
        {
          "text": "Otevření modulu a orientace v přehledech",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "localId": "0bdcf6d32bb9",
        "order": 1
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "6b7f8779dc78"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3795c77bc6d9"
              },
              "content": [
                {
                  "text": "Otevřete modul Centrová léčba z hlavního menu systému FONS Galen. ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
                "width": 135,
                "widthType": "pixel"
              },
              "content": [
                {
                  "type": "media",
                  "attrs": {
                    "width": 135,
                    "alt": "obrazek-20260224-080708.png",
                    "id": "d12500dd-4431-4e9f-b6a8-ec0623f2f566",
                    "collection": "contentId-281739265",
                    "type": "file",
                    "localId": "ba32f9acc71a",
                    "height": 94
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "079dfd0aa1b9"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "9ba7943165ee"
              },
              "content": [
                {
                  "text": "V modulu uvidíte dvě záložky: Léčby a Podání.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "f5e81de9ccb4"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "efaa1b884b9d"
              },
              "content": [
                {
                  "text": "Záložka Léčby zobrazuje seznam všech léčeb (pacient, diagnóza, léčivo, paragraf, stav).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "4e4a42ef82a8"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "988e5965d33d"
              },
              "content": [
                {
                  "text": "Záložka Podání zobrazuje přehled jednotlivých aplikací léčiva ke každé léčbě.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "f6edc868454d"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "48334a527324"
              },
              "content": [
                {
                  "text": "Použijte filtry v horní části obrazovky pro vyhledání podle pacienta, léčiva, stavu, paragrafu nebo časového období.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "2c863014f8f7"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "51bef8920bba"
              },
              "content": [
                {
                  "text": "Dvojklikem na řádek otevřete detail léčby nebo detail podání.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
