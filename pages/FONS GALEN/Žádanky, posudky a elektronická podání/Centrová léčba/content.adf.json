          },
          "content": [
            {
              "text": "Nová léčba",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "rule",
      "attrs": {
        "localId": "9bb59f30568a"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "ae05b93ae59c"
      },
      "content": [
        {
          "text": "Zaznamenání podání léčiva",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "localId": "238782d9afd6",
        "order": 1
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "26ea796243c0"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "8ce099298579"
              },
              "content": [
                {
                  "text": "V přehledu léčeb dvojklikem otevřete detail příslušné léčby, nebo přejděte přímo do záložky Podání.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "559fa3f44f73"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "2bf1dd3ab3d4"
              },
              "content": [
                {
                  "text": "Klikněte na tlačítko pro přidání nového podání.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "cca35672eefd"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "824138c8cef7"
              },
              "content": [
                {
                  "text": "Vyplňte: datum podání, léčivo, množství a další potřebné údaje.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "6b4f081d8f6c"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d80521cd5514"
              },
              "content": [
                {
                  "text": "Uložte podání. Systém automaticky zkontroluje, zda datum podání spadá do platnosti léčby.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "0372043313db"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3253060d7b61"
              },
              "content": [
                {
                  "text": "Po uložení je podání evidováno ve stavu Rozpracováno.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "f7e2284421ca"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "020ba02f5f65"
              },
              "content": [
                {
                  "text": "Po odeslání do ÚZIS je podání evidováno ve stavu Odesláno.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "1c6059c49bf7"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "862828bc8153"
              },
              "content": [
                {
                  "text": "Podání, které ještě nebylo odesláno na ÚZIS, lze upravit nebo smazat.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "63739b390d56"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3e0f416eeeb6"
              },
              "content": [
                {
                  "text": "Podání, které již bylo odesláno na ÚZIS, lze upravit nebo stornovat.Odeslání podání na ÚZIS a automatické vykázání výkonu",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
