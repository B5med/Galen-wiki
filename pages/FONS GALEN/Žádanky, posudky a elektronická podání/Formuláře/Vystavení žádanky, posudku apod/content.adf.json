            "type": "file",
            "height": 231
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Žádanky, posudky a jiné formuláře jsou zobrazeny ve své grafické podobě, takže uživatel vidí, kam co na formuláři přesně vyplňuje. To, co lze předvyplnit z karty pacienta, je již předvyplněné.",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": " ",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 360,
        "widthType": "pixel"
      },
