      "content": [
        {
          "type": "paragraph",
          "attrs": {
            "localId": "597eaa14-eac2-4662-9025-8199ba8aac80"
          },
          "content": [
            {
              "text": "Pomocí formuláře ",
              "type": "text"
            },
            {
              "text": "ÚZIS žádanka testu COVID-19",
              "type": "text",
              "marks": [
                {
                  "type": "em"
                }
              ]
            },
            {
              "text": " lékař odesílá informace do systému ÚZIS ISIN v souvislosti v provedením testu Covid-19 a/nebo vystavením žádanky na test Covid-19.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "aaa826dd-fc31-4401-9b85-23c9d672690c"
      },
      "content": [
        {
          "text": "Pro uživatele jsou připravené dvě varianty formulářů. Obě mají stejný obsah a účel, rozdíl je ve jejich formě. ",
          "type": "text"
        }
      ]
    },
    {
      "type": "extension",
      "attrs": {
        "layout": "default",
        "extensionType": "com.atlassian.confluence.macro.core",
