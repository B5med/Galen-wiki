          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3397789b-80ce-4c67-a335-97e476ecf68a"
              },
              "content": [
                {
                  "text": "Registr zdravotnických pracovníků",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "5d90fa03-c94c-447d-8f4f-cdb4f4d5f82c"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "bb33f176-7faf-463c-9530-8818170eaba3"
              },
              "content": [
                {
                  "text": "Odběrová místa",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "65cf3d72-889c-4891-84ce-13f7e5bfa6b8"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "6fa29c90-9f6a-4d45-947b-c69503175ac1"
              },
              "content": [
                {
                  "text": "Výrobci testů",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "7b93c9ab-a0ee-4be4-9427-83ae5bab02f9"
      },
      "content": [
        {
          "text": "Uživatel pomocí tl. ",
          "type": "text"
        },
        {
          "text": "Aktualizovat",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " načte aktuální číselníky.",
          "type": "text"
        }
      ]
    },
