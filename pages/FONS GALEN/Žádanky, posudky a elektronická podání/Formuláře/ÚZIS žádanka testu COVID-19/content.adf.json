          }
        },
        "localId": "257ad605-c126-4d1e-a4ba-1c66a08df6f0"
      }
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "c91863e1-5c36-4928-8396-1f817650c93b"
      },
      "content": [
        {
          "text": "ÚZIS žádanka testu COVID-19",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "7c84f954-ee07-4052-b610-7d9755890dca"
      },
      "content": [
        {
          "text": "Pro odeslání této žádanky je nutné vyplnit pole Klíč ÚZIS v nastavení společnosti (",
          "type": "text"
        },
        {
          "text": "Správce → Správa organizace →",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " Společnost ",
          "type": "text"
        },
        {
          "text": "→",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " Klíč ÚZIS). ",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 422,
        "widthType": "pixel"
      },
      "content": [
