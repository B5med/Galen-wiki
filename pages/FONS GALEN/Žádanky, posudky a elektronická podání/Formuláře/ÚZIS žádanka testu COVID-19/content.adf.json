    {
      "type": "heading",
      "attrs": {
        "level": 4,
        "localId": "c478f51c-665d-4f6a-984c-95601b388a7b"
      },
      "content": [
        {
          "text": "Vyplněná hodnota PČZ - pořadové číslo zařízení",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "7c9086b9-74c4-4fa2-93d5-95224e5119a9"
      },
      "content": [
        {
          "text": "Na úrovni pracoviště je dále nutné vyplnit položku PČZ - pořadové číslo zařízení.",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "fb50f095-a1f4-4796-b732-10b7f1da1055"
      },
      "content": [
        {
          "text": "Správce → Správa organizace →",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " Struktura společnosti ",
          "type": "text"
        },
        {
          "text": "→",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " úroveň pracoviště",
          "type": "text"
        }
      ]
    },
    {
