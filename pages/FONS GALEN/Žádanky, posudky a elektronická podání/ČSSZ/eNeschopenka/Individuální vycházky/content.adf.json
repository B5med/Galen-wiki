            {
              "type": "paragraph",
              "attrs": {
                "localId": "bb2aae918a80"
              },
              "content": [
                {
                  "text": "Tento checkbox uživatel zatrhne a vyplní požadované informace vč. přílohy. Poté odesílá žádost na ČSSZ.",
                  "type": "text"
                }
              ]
            },
