      },
      "content": [
        {
          "text": "Postup v případě, kdy je pacientovi potřeba povolit individuální vycházky:",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "localId": "6838e3ba1e9e",
        "order": 1
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "45a9e35ddfa1"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "885f3a9a95f2"
              },
              "content": [
                {
                  "text": "Vystavit eNeschopenku klasickým způsobem a odeslat na ČSSZ.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "6a0f72d75549"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "f3bdb8780090"
              },
              "content": [
                {
                  "text": "Po úspěšném vystavení eNeschopenky se na detailu zobrazí checkbox Žádost o povolení individuálních vycházek.",
                  "type": "text"
                }
              ]
            },
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
                "width": 736,
                "widthType": "pixel"
              },
              "content": [
                {
                  "type": "media",
                  "attrs": {
                    "width": 773,
                    "alt": "image-20260204-103015.png",
                    "id": "9df0539d-b78f-4ef0-ae03-ee02ef012f09",
                    "collection": "contentId-257916930",
                    "type": "file",
