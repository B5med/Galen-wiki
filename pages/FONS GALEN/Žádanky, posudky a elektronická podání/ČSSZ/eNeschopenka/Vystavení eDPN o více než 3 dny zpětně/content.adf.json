        {
          "type": "listItem",
          "attrs": {
            "localId": "787f3504e325"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "f23225917886"
              },
              "content": [
                {
                  "text": "Pokud ČSSZ žádost schválí, je podání “Zolusu” ve stavu ",
                  "type": "text"
                },
                {
                  "text": "Zpracováno",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": ". Tento stav se do FONS Galen načte automaticky. ",
                  "type": "text"
                }
              ]
            },
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
