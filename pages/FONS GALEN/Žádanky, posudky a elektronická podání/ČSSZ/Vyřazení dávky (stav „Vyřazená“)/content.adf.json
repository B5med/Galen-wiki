      },
      "content": [
        {
          "text": "Dávka ve stavu ",
          "type": "text"
        },
        {
          "text": "„Vyřazená“",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " se chová stejně jako dávka ve stavu ",
          "type": "text"
        },
        {
          "text": "Ukončená",
          "type": "text",
          "marks": [
            {
              "type": "strong"
