    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "fcf3e3bd2551"
      },
      "content": [
        {
          "text": "Každá změna stavu, tedy vyřazení i obnovení, se zaznamenává do samostatné evidence ",
