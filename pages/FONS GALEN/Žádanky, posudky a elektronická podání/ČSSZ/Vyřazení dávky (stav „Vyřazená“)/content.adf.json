            {
              "type": "paragraph",
              "attrs": {
                "localId": "430db9643e0b"
              },
              "content": [
                {
                  "text": "Není aktivní pro další zpracování; k vyřazené dávce není možné odesílat podání na ČSSZ.",
                  "type": "text"
                }
              ]
            }
          ]
