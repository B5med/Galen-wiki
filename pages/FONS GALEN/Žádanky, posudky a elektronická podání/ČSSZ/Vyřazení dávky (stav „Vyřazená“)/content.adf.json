                {
                  "text": "Nezobrazuje se v přehledu neodeslaných lístků na peníze.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "eb9ac6910565"
