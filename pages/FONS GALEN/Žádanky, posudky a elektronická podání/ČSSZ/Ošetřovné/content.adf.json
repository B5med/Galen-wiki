    {
      "type": "paragraph",
      "content": [
        {
          "text": "Stisknutím tlačítka ",
          "type": "text"
        },
        {
          "text": "Odeslat",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " uživatel lístek na peníze odešle ",
          "type": "text"
        },
