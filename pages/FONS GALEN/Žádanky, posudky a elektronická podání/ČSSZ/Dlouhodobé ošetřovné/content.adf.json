          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Po odeslání Potvrzení o trvání potřeby může uživatel vytisknout formulář ",
          "type": "text"
        },
        {
          "text": "Potvrzení o trvání potřeby ",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": "pomocí tlačítka ",
          "type": "text"
        },
        {
          "text": "Tisk ",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "type": "mediaInline",
          "attrs": {
