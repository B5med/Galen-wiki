            {
              "type": "em"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Převzetí do péče",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Převzetí stávajícího Dlouhodobé ošetřovného do péče daného pracoviště je možné několika způsoby.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "Převzetí do péče prostřednictvím nahlížení na záznamy jiného pracoviště",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Pokud bylo Dlouhodobé ošetřovné vystaveno na jiném pracovišti dané společnosti a pokud mají tato pracoviště mezi sebou nastaveno nahlížení, může uživatel Dlouhodobé ošetřovné, které chce převzít, vybrat ze seznamu v záložce ",
          "type": "text"
        },
        {
          "text": "Vedené v IS Galen.",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 616,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 260,
            "alt": "image-20250724-091239.png",
            "id": "4016841d-b3cc-4053-af08-50c9f30b5a94",
            "collection": "contentId-79724546",
            "type": "file",
            "height": 135
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Po označení konkrétního řádku stiskne tlačítko ",
          "type": "text"
        },
        {
          "text": "Převzít do péče.",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Detail Dlouhodobé ošetřovného před převzetím není načten, tzn. že notifikace, důvod vystavení Dlouhodobé ošetřovného, nebo datum ",
          "type": "text"
        },
        {
          "text": "Potřeba ošetřování/péče od ",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        },
        {
          "text": " není aktuální (před odesláním jsou vyplněné výchozí hodnoty).",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 610,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 274,
            "alt": "image-20250724-091300.png",
            "id": "fce1ca54-a744-41e5-a5d6-2c89e40c1355",
            "collection": "contentId-79724546",
            "type": "file",
            "height": 162
          }
        }
      ]
    },
    {
