  "content": [
    {
      "type": "paragraph",
      "attrs": {
        "localId": "d0c23f8a30e8"
      },
      "content": [
        {
          "text": "Modul ",
          "type": "text"
        },
        {
          "text": "ePosudek",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " umožňuje vystavovat, odesílat a spravovat elektronické lékařské posudky v souladu s požadavky systému ",
          "type": "text"
        },
        {
          "text": "ELP",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " (Elektronické lékařské posudky) provozovaného NCEZ / MZ ČR. Odesílání posudků probíhá přes zabezpečené spojení (HTTPS/TLS, OAuth 2.0) s použitím systémového certifikátu PZS.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "23dd73a77598"
      },
      "content": [
        {
          "text": "Přehled typů posudků",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "12efb8c7f683"
      },
      "content": [
        {
          "text": "Každý typ posudku je popsán v samostatné podstránce:",
          "type": "text"
        }
      ]
    },
    {
      "type": "extension",
      "attrs": {
        "layout": "default",
        "extensionType": "com.atlassian.confluence.macro.core",
