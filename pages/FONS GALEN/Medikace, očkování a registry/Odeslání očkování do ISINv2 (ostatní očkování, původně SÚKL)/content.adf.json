        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 671,
            "alt": "image-20250826-115611.png",
            "id": "bb85f4ec-5cca-4bfd-809a-b01a53c4b2a1",
            "collection": "contentId-104824874",
            "type": "file",
            "height": 337
          }
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Poznámka k modulu eOčkování ",
          "type": "text"
        }
      ]
    },
    {
      "type": "layoutSection",
      "content": [
        {
          "type": "layoutColumn",
          "attrs": {
            "width": 50.0
          },
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Modul eOčkování (k dispozici v horní liště nebo v záložce modulu Očkování) zobrazuje informace, které jsou poskytovány ze strany SÚKL. Tam se původně záznamy o očkování odesílaly. Po změně legislativy se záznamy odesílají do ISIN, ale správcem poskytující informace o provedených očkování je stále SÚKL. Propojení mezi SÚKL a ISIN není v tuto chvíli realizované, a proto očkování odeslaná z FONS Galen do ISIN, nebudou v tuto chvíli v modulu eOčkování viditelná. ",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "layoutColumn",
          "attrs": {
            "width": 50.0
          },
          "content": [
            {
              "type": "mediaSingle",
              "attrs": {
                "layout": "center",
                "width": 214,
                "widthType": "pixel"
              },
              "content": [
                {
                  "type": "media",
                  "attrs": {
                    "width": 122,
                    "alt": "image-20250826-115637.png",
                    "id": "32a516c1-ab6b-4d88-9d03-6558d3d81ddd",
                    "collection": "contentId-104824874",
