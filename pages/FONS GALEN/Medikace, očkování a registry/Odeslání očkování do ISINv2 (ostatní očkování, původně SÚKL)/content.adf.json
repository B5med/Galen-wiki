            "alt": "image-20250826-115559.png",
            "id": "071b501c-6bcd-4476-a699-0b558b525075",
            "collection": "contentId-104824874",
            "type": "file",
            "height": 585
          }
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
