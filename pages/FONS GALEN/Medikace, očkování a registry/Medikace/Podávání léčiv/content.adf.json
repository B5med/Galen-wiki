            "collection": "contentId-75104313",
            "type": "file",
            "height": 248
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Vybereme odpovědného pracovníka. A potvrdíme.   ",
          "type": "text"
        }
      ]
    },
