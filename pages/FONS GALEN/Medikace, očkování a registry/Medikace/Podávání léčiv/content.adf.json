              "type": "code"
            }
          ]
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "Když ukončíme práci u vybraného pacienta, potvrdíme tlačítkem OK, a vrátíme se do modulu sestavy. ",
          "type": "text"
        }
