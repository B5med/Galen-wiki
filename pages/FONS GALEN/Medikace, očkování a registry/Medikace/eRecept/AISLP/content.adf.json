              "type": "paragraph",
              "content": [
                {
                  "text": "V konfiguraci uživatele – povolit přístup k AISLP. ",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
