    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Postup konfigurace funkcionality je následující:",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " ",
          "type": "text"
        }
