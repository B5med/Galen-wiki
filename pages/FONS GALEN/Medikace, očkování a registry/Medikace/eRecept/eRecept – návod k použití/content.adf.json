        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Akutní",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " - symbol Akutní péče nebo Neodkladná péče  ",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
