        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "V případě, že je vydáván lék v listinné podobě, do této poznámky se uvádí důvod vydání receptu v listinné podobě.  ",
                  "type": "text"
                }
              ]
            }
          ]
        }
