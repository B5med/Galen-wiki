          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Hodnotu lze vymazat kliknutím pravým tlačítkem myši a vybráním možnosti „Vymazat“.  ",
                  "type": "text"
                }
              ]
