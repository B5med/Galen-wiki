                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " (dny) – přednastavena je platnost receptu je 14 dní (lze změnit)  ",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "U antibiotik (ATC začínající na J01) je nastavena platnost 5 dní (lze změnit)  ",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "U receptů s vyplněným opakováním je platnost 182 dní (lze změnit)  ",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Po zatržení Akutní je platnost 2 dny, tzn. lék je platný do následujícího dne po vydání  ",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Pozn",
