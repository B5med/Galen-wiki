        "order": 2
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "214c4d1e-436f-4b13-a9d7-1c04509c3e58"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d50d0667-53f8-4646-8ecc-ae8b1c4b836b"
              },
              "content": [
                {
                  "text": "Odb. 002: ",
                  "type": "text"
                },
                {
                  "text": "09555",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
