        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "f9b9605238d8"
      },
      "content": [
        {
          "text": "Následně uživatel vybere způsob exportu certifikátu.",
          "type": "text"
        }
      ]
    },
