{
  "type": "doc",
  "content": [
    {
      "type": "extension",
      "attrs": {
        "layout": "default",
        "extensionType": "com.atlassian.confluence.macro.core",
        "extensionKey": "toc",
        "parameters": {
          "macroParams": {
            "minLevel": {
              "value": "1"
            },
            "maxLevel": {
              "value": "3"
            },
            "outline": {
              "value": "true"
            },
            "style": {
              "value": "none"
            },
            "type": {
              "value": "list"
            },
            "printable": {
              "value": "true"
            }
          },
          "macroMetadata": {
            "macroId": {
              "value": "1917e687-477a-4835-9f21-2cb5a9b50b5f"
            },
            "schemaVersion": {
              "value": "1"
            },
            "title": "Obsah"
          }
        },
        "localId": "78198a96-92eb-4562-b948-193ec65bce8c"
      }
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Smlouvy představují klíčovou část modulu ",
              "type": "text"
            },
            {
              "text": "Nadstandardní péče",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            },
            {
              "type": "hardBreak"
            },
            {
              "text": "Definují podmínky spolupráce s konkrétní firmou – tedy jaké služby a vyšetření se budou provádět, jak často a jak budou fakturována.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "type": "emoji",
          "attrs": {
            "id": "2795",
            "text": "➕",
            "shortName": ":heavy_plus_sign:"
          }
        },
        {
          "text": " Založení nové smlouvy",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Novou smlouvu lze vytvořit:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "od začátku",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " pomocí tlačítka ",
                  "type": "text"
                },
                {
                  "text": "„Nová“",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ", nebo",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "zkopírováním existující smlouvy",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " z jiné firmy (např. při podobném typu spolupráce).",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "⚠️ Pro vytvoření smlouvy je nutné, aby firma měla alespoň ",
              "type": "text"
            },
            {
              "text": "jednu aktivní pobočku",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 4
      },
      "content": [
        {
          "text": "Možnosti při kopírování:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Lze kopírovat libovolnou existující smlouvu ze všech firem.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Název nové smlouvy se po kopírování automaticky doplní jako ",
                  "type": "text"
                },
                {
                  "text": "„Kopie“",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " původní.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "⚙️ Nastavení smlouvy",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 4
      },
      "content": [
        {
          "text": "Základní parametry:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Platnost od / do",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – určuje období, pro které je smlouva aktivní.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Nefakturovat",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – pokud je zaškrtnuto, ze smlouvy se negenerují žádné faktury (ani výkonové, ani paušální).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Způsob platby",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – definuje typ fakturace:",
                  "type": "text"
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Kombinovaně",
                          "type": "text",
                          "marks": [
                            {
                              "type": "strong"
                            }
                          ]
                        },
                        {
                          "text": " – generují se jak výkonové, tak paušální faktury,",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Paušál",
                          "type": "text",
                          "marks": [
                            {
                              "type": "strong"
                            }
                          ]
                        },
                        {
                          "text": " – generují se pouze pravidelné paušální faktury,",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Výkony",
                          "type": "text",
                          "marks": [
                            {
                              "type": "strong"
                            }
                          ]
                        },
                        {
                          "text": " – generují se pouze faktury za jednotlivé výkony, a to zpětně (za uzavřené položky z předchozího měsíce).",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 4
      },
      "content": [
        {
          "text": "Nastavení paušálu:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Režim platby paušálu",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Dopředu",
                          "type": "text",
                          "marks": [
                            {
                              "type": "em"
                            }
                          ]
                        },
                        {
                          "text": " – faktura se vytváří za aktuální měsíc,",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Zpětně",
                          "type": "text",
                          "marks": [
                            {
                              "type": "em"
                            }
                          ]
                        },
                        {
                          "text": " – faktura se vytváří za předchozí měsíc.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Počet měsíců paušálu",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – určuje, jak často se faktury generují (např. 1 = měsíčně, 3 = čtvrtletně, 12 = ročně).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Typ paušálu",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Jednorázový",
                          "type": "text",
                          "marks": [
                            {
                              "type": "em"
                            }
                          ]
                        },
                        {
                          "text": " – paušál se fakturuje jako jedna částka,",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Za 1 pacienta",
                          "type": "text",
                          "marks": [
                            {
                              "type": "em"
                            }
                          ]
                        },
                        {
                          "text": " – faktura obsahuje cenu paušálu × počet uzavřených položek (např. počet provedených prohlídek).",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "💰 Fakturace „Nedostavil se“",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "V rámci smlouvy lze určit, zda se mají fakturovat i případy, kdy se zaměstnanec nedostavil na prohlídku.",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Fakturovat stav „Nedostavil se“",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                }
              ]
            },
            {
              "type": "bulletList",
              "content": [
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Pokud je volba aktivní, systém vygeneruje fakturu i za prohlídku, která byla uzavřena tímto výsledkem.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Lze nastavit buď ",
                          "type": "text"
                        },
                        {
                          "text": "procento z ceny",
                          "type": "text",
                          "marks": [
                            {
                              "type": "strong"
                            }
                          ]
                        },
                        {
                          "text": ", nebo ",
                          "type": "text"
                        },
                        {
                          "text": "pevnou částku",
                          "type": "text",
                          "marks": [
                            {
                              "type": "strong"
                            }
                          ]
                        },
                        {
                          "text": " (bez DPH).",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "listItem",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "text": "Pokud jsou vyplněny obě hodnoty, uplatní se procento.",
                          "type": "text"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "💡 Typický příklad:",
              "type": "text"
            },
            {
              "type": "hardBreak"
            },
            {
              "text": "Cena hlavní položky 1000 Kč, smluvně dohodnutý poplatek za nedostavení se = 20 %.",
              "type": "text"
            },
            {
              "type": "hardBreak"
            },
            {
              "text": "Do faktury se promítne částka 200 Kč.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "📋 Položky smlouvy",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Každá smlouva se skládá z ",
          "type": "text"
        },
        {
          "text": "hlavních položek",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " (např. prohlídky, očkování) a volitelně také z ",
          "type": "text"
        },
        {
          "text": "rozšiřujících položek",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " (např. laboratorní testy, doplňková vyšetření).",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 4
      },
      "content": [
        {
          "text": "Hlavní položky:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "jsou základními službami poskytovanými v rámci smlouvy,",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "vždy mají vazbu na konkrétní ",
                  "type": "text"
                },
                {
                  "text": "skupinu PLS",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ",",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "mohou být účtovány buď ",
                  "type": "text"
                },
                {
                  "text": "fakturou",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ", nebo ",
                  "type": "text"
                },
                {
                  "text": "v hotovosti",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ",",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "lze omezit jejich použití podle ",
                  "type": "text"
                },
                {
                  "text": "věku a pohlaví",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " pacienta.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 4
      },
      "content": [
        {
          "text": "Rozšiřující položky:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "navazují na konkrétní hlavní položku (např. vstupní prohlídku),",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "při vytvoření prohlídky se automaticky načtou do formuláře,",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "jejich cena se do faktury zahrne společně s hlavní položkou.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "blockquote",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "💡 Doporučení:",
              "type": "text"
            },
            {
              "type": "hardBreak"
            },
            {
              "text": "Pokud má firma specifické požadavky (např. povinné testy pro určité profese), přidejte je jako rozšiřující položky k příslušné prohlídce.",
              "type": "text"
            }
          ]
        }
      ]
    }
  ],
  "version": 1
}
