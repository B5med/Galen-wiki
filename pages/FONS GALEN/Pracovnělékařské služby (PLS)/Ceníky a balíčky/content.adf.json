{
  "type": "doc",
  "content": [
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "Ceníky a balíčky",
          "type": "text"
        }
      ]
    },
    {
      "type": "extension",
      "attrs": {
        "layout": "default",
        "extensionType": "com.atlassian.confluence.macro.core",
        "extensionKey": "toc",
        "parameters": {
          "macroParams": {
            "style": {
              "value": "none"
            }
          },
          "macroMetadata": {
            "macroId": {
              "value": "0dee38de-aac0-4bba-8e01-5a60bde8471d"
            },
            "schemaVersion": {
              "value": "1"
            },
            "title": "Obsah"
          }
        },
        "localId": "7f6f35ac-c8d4-4b76-aaeb-061efb856edc"
      }
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Ceník slouží jako centrální přehled všech položek, které lze v modulu ",
              "type": "text"
            },
            {
              "text": "Nadstandardní péče",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": " použít – ať už pro tvorbu smluv, vykazování výkonů, nebo přímé účtování pacientům v okně ",
              "type": "text"
            },
            {
              "text": "Stav účtu",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "Ceníky",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 4
      },
      "content": [
        {
          "text": "Členění",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Ceník je rozdělen do několika skupin:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Sortiment",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – běžné položky (např. výkony, vyšetření, očkování),",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Prohlídky",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – definované v modulu Design,",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Očkování",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – vazba na konkrétní očkovací látku,",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Služby",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – doplňkové služby (např. školení první pomoci),",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Balíčky",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – kombinace více položek do jedné služby.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Každou skupinu je možné dále filtrovat podle ",
          "type": "text"
        },
        {
          "text": "kategorie",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " (např. laboratorní vyšetření, očkování, administrativa).",
          "type": "text"
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 4
      },
      "content": [
        {
          "text": "Nastavení položek v ceníku",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Každá položka má tyto základní parametry:",
          "type": "text"
        }
      ]
    },
    {
      "type": "table",
      "attrs": {
        "layout": "default",
        "width": 760.0,
        "localId": "e6a9a224-ec90-4a11-9ee0-566ca0555981"
      },
      "content": [
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableHeader",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Pole",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableHeader",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Popis",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Aktivní stav",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Položku lze označit jako ",
                      "type": "text"
                    },
                    {
                      "text": "aktivní",
                      "type": "text",
                      "marks": [
                        {
                          "type": "em"
                        }
                      ]
                    },
                    {
                      "text": ", ",
                      "type": "text"
                    },
                    {
                      "text": "neaktivní",
                      "type": "text",
                      "marks": [
                        {
                          "type": "em"
                        }
                      ]
                    },
                    {
                      "text": " nebo ",
                      "type": "text"
                    },
                    {
                      "text": "neexistující",
                      "type": "text",
                      "marks": [
                        {
                          "type": "em"
                        }
                      ]
                    },
                    {
                      "text": " (informativní stav).",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Kód a název",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Povinné údaje. Kód slouží pro interní identifikaci.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Doplněk",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Volitelný popis položky (zobrazí se např. na faktuře).",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Pořadí",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Určuje, v jakém pořadí se položka tiskne a exportuje do faktur.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Variabilní cena",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Pokud je zaškrtnuto, lze cenu při účtování v modulu Ordinace ručně upravit.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Cena a cena vč. DPH",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Zadává se jedna z hodnot, druhá se automaticky dopočítá.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Sazba DPH",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Možnosti: 0 %, 10 %, 15 %, 21 %.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Platnost od–do",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Definuje období, po které je cena platná.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Odbornost / pracoviště",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Omezuje platnost ceny na danou odbornost nebo konkrétní pracoviště.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "version": 1
}
