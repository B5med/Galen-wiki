                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Na spodní modré liště v modulu ",
                  "type": "text"
                },
                {
                  "text": "Ordinace ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": "v části ",
                  "type": "text"
                },
                {
                  "text": "Dekurz ",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": "se zobrazuje nejbližší objednávka pacienta v kalendáři daného pracoviště nebo v kalendáři, do kterého má dané pracoviště nastaven přístup. ",
