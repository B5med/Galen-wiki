          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "e2d63ed4e214"
              },
              "content": [
                {
                  "text": "elektronické odeslání hlášení přes ",
                  "type": "text"
                },
                {
                  "text": "API ÚZIS",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ",",
                  "type": "text"
                }
              ]
            }
          ]
