        {
          "text": "„Objednat“",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " v horní liště.",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "c2340abe172e"
      },
      "content": [
        {
          "text": "Po kliknutí se otevře ",
          "type": "text"
        },
        {
