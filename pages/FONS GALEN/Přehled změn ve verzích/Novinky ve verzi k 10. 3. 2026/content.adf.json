          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "44869dd91051"
              },
              "content": [
                {
                  "text": "pacientem,",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "f4f2de68-7452-4af2-ae6f-8f206fea73a1"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "91240f4c6f94"
