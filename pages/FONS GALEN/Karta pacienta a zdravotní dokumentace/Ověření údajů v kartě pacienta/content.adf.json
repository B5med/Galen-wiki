    {
      "type": "paragraph",
      "content": [
        {
          "type": "hardBreak"
        },
        {
          "text": "Pokud je potřeba údaje ověř znovu, je možné tak učinit pomocí tlačítka „Znovu ověřit“.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 624,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
            "width": 624,
            "alt": "image-20250722-080924.png",
