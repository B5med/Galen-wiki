      },
      "content": [
        {
          "text": "Funkce ",
          "type": "text"
        },
        {
          "text": "Odložení pacienta",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " umožňuje dočasně přerušit práci s aktuálně otevřeným pacientem a uložit ho do schránky, aniž by se ztratil rozpracovaný kontext. Kdykoli se uživatel potřebuje věnovat jinému pacientovi nebo úkonu, může se k odloženému pacientovi jednoduše vrátit a pokračovat přesně tam, kde přestal.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2,
        "localId": "e095f4680715"
      },
      "content": [
        {
          "text": "Jak funkce funguje",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "8095f6b3688a"
      },
      "content": [
        {
          "text": "Tlačítko schránky je zobrazeno v horním panelu modulu.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 736,
        "widthType": "pixel"
      },
      "content": [
        {
          "type": "media",
          "attrs": {
