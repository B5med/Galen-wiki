      "attrs": {
        "localId": "0cd8e0714c34"
      },
      "content": [
        {
          "text": "Jedná se o nadstandardní placenou funkcionalitu. Po objednání ze strany zákazníka je funkcionalita zpřístupněna.",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
