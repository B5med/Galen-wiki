                {
                  "text": "Objednávání",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " – funkce je dostupná v modulu Objednávání (recepce)",
                  "type": "text"
                }
              ]
            }
          ]
        }
