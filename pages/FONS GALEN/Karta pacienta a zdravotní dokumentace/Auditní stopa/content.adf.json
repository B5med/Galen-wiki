    {
      "type": "paragraph",
      "attrs": {
        "localId": "9506426a3fa5"
      },
      "content": [
        {
          "text": "Poukazy a žádanky",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "type": "hardBreak"
        },
        {
          "text": "ePoukaz (základní, foniatrický, léčebný, optický, položky, přílohy, výdej), žádanka RDG (včetně EZD varianty), poukaz FT – EZD, externí žádanka.",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 760,
        "widthType": "pixel"
      },
