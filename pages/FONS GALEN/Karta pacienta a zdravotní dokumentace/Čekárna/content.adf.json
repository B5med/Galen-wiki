    {
      "type": "paragraph"
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Následně, v případě více kalendářů, má možnost výběru a napsání poznámky pro lékaře.",
          "type": "text"
        }
      ]
    },
