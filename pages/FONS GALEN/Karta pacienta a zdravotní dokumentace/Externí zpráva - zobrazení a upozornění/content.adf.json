          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Externí zprávy se zobrazují na těchto místech:",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "V modulu komunikace",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
        "layout": "center",
        "width": 360,
        "widthType": "pixel"
      },
      "content": [
        {
