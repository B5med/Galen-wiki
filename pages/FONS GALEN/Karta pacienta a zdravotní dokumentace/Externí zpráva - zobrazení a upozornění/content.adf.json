            "type": "file",
            "height": 80
          }
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Po vybrání konkrétní zprávy se zobrazí z pravé části",
          "type": "text"
        }
      ]
    },
    {
      "type": "mediaSingle",
      "attrs": {
