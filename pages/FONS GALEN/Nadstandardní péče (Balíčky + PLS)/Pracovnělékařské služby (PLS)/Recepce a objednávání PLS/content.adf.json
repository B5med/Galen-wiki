                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Datum plánované prohlídky je 15–90 dní v budoucnosti.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Červená",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Datum plánované prohlídky je 0–15 dní (včetně dnešního dne).",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "2. Klíčové informace zobrazené u pacienta",
          "type": "text"
        }
      ]
    },
    {
      "type": "table",
      "attrs": {
        "layout": "default"
      },
      "content": [
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableHeader",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Pole",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableHeader",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Popis",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Interval prohlídky",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Zobrazuje se vždy, je-li vypočitatelný. Počítá se jako minimum z intervalů všech rizik přiřazených PLS skupině pacienta.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Platnost posudku",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Přepisuje se na kartu pacienta. Určuje datum plánované prohlídky pouze tehdy, pokud: (1) neexistuje ukončená hlavní PLS prohlídka k dané firmě, (2) je v daném období na pobočce aktivní vedení lhůtníku, a (3) správce nestanovil datum prohlídky ručně. Zobrazuje se a lze přepsat i v případě, kdy je datum v minulosti.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Výsledek poslední prohlídky",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Přepíše se okamžitě do PLS aplikace a PLS Admina. Do výpočtu plánované prohlídky vstupuje pouze v případě, kdy neexistuje výsledek předposlední prohlídky — tehdy se obě hodnoty porovnávají.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Poslední prohlídka OL",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Zobrazuje datum návštěvy z prohlídky. Pro zobrazení prohlídky NL musí mít prohlídka v Designéru nastaven příznak „Ovlivňuje lhůtu — Ne\".",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Texty u pole Plánovaná prohlídka:",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "určeno lékařem",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " — datum stanovil lékař přímo na prohlídce",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "určeno správcem",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " — datum nastavil správce v okně PLS Admin",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "z importu",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " — datum pochází z importu nebo z data platnosti posudku",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Bez textu — datum bylo dopočítáno systémem automaticky",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "3. Stav objednávky",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Celkový přehled objednávek je zobrazen v postranním panelu u firmy. Aby se objednávka zobrazila, musí být typ objednávky ",
          "type": "text"
        },
        {
          "text": "PLS",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " (vytvořená přes tlačítko PLS — vytváří se vazba na položku smlouvy PLS).",
          "type": "text"
        }
      ]
    },
    {
      "type": "table",
      "attrs": {
        "layout": "default"
      },
      "content": [
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableHeader",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Stav",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableHeader",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Podmínka",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Není objednán",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Neexistuje PLS objednávka v kalendáři, nebo je objednávka v minulosti.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Objednán",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Existuje PLS objednávka na dnešek nebo v budoucnosti, přičemž dosud nebyla vytvořena odpovídající PLS prohlídka. Zobrazuje se vždy nejpozdější budoucí objednávka.",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "tableRow",
          "content": [
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "K objednání",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableCell",
              "attrs": {
                "colspan": 1,
                "rowspan": 1
              },
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Stav nastavitelný pouze v PLS aplikaci. V Recepci a Objednávání se zobrazí poznámka z PLS aplikace a tlačítko „Zrušit\" (nastaví stav zpět na Není objednán).",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Tooltip nad objednávkou zobrazuje: uživatel, pracoviště a čas vytvoření objednávky. Při více objednávkách se zobrazuje vždy ta s nejvyšším datem (nejdále v budoucnosti). Nová objednávka přepíše záznam u všech firem ve stavu „Objednán\", pokud má vyšší datum objednání.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "4. Tlačítko PLS — vytvoření objednávky",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Po kliknutí na tlačítko ",
          "type": "text"
        },
        {
          "text": "PLS",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " v Recepci nebo Objednávání se zobrazí výběr prohlídek (stejný jako v okně Prohlídky a vyšetření). Po zvolení prohlídky se otevře okno s možností:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Přidat další sortiment k objednávce.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Vybrat skupinu pracovišť a konkrétní pracoviště.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Zobrazit dostupné kalendáře vybraných pracovišť (defaultně zobrazeno od začátku aktuálního týdne).",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Po vytvoření objednávky se do interní poznámky pro lékaře automaticky zapíše název prohlídky a přidané položky. U objednávky typu PLS prohlídka se nabídne combo-box s výběrem PLS prohlídky pro přiřazení. V combo-boxu jsou všechny položky ze všech smluv dané pobočky.",
          "type": "text"
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "5. Konfigurace prohlídky a eŽádanky (nákladová střediska)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Funkce umožňuje přednastavit povinné parametry PLS prohlídek a předvyplněné položky eŽádanek na základě pracovního zařazení pacienta (nákladového střediska). Předejde se tím chybám — systém upozorní lékaře, pokud zadá parametry nad nebo pod doporučený výběr.",
          "type": "text"
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Podmínka: Na společnosti musí být aktivní nadstandardní modul ",
              "type": "text"
            },
            {
              "text": "Nákladová střediska",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": ". Viz také stránku ",
              "type": "text"
            },
            {
              "text": "Nákladová střediska",
              "type": "text",
              "marks": [
                {
                  "type": "link",
                  "attrs": {
                    "href": "https://stapro-galen.atlassian.net/wiki/spaces/fg/pages/75268151"
                  }
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Přístup: ",
          "type": "text"
        },
        {
          "text": "Nadstandardní péče → detail firmy → záložka Nákladová střediska → označit středisko → tlačítko Konfigurace prohlídky / Konfigurace eŽádanky",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "5.1 Konfigurace prohlídky",
