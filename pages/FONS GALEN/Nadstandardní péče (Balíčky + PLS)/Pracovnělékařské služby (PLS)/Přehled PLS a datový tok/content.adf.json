              "type": "em"
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "f7af8ef9f0b9"
      },
      "content": [
        {
          "text": "Pořadí kroků při práci s pracovnělékařskými službami — od nastavení až po fakturaci:",
          "type": "text",
          "marks": [
            {
              "type": "em"
            }
          ]
        }
      ]
    },
    {
      "type": "codeBlock",
      "attrs": {
        "localId": "599bfc83-2a80-40ca-b562-2fa63df5329e"
      },
      "marks": [
        {
          "type": "breakout",
          "attrs": {
            "mode": "wide",
            "width": 760
          }
        }
      ],
      "content": [
        {
          "text": "  1. Firma (zaměstnavatel) + Pobočka        ← předpoklad, zakládá správce\n  2. Skupiny PLS (pozice zaměstnanců)\n       └─ Rizika skupiny (druhy rizik)\n  3. Smlouva PLS  ─────────────────────────  platnost, způsob platby\n       └─ Položky smlouvy PLS              ← typ prohlídky/sortimentu,\n            └─ Skupina PLS                   cena, limit, vazba (výkon/paušál)\n  4. Objednávka PLS (od zaměstnavatele)\n       └─ Položky objednávky + Přílohy\n  5. Akce PLS (plánovaná prohlídka)         ← stav: Nová plánovaná akce\n       └─ Pacient + Pracoviště\n       └─ Vyšetření (po provedení)          ← stav: → Uzavřena, fakturovat\n       └─ Výsledek posudku (PLSResult)\n  6. Vyúčtování PLS (hromadná příprava)\n       └─ Faktura PLS                       ← číslo, období, typ, identifikace pac.\n            └─ Položky faktury PLS",
          "type": "text"
        }
      ]
    },
    {
      "type": "rule",
      "attrs": {
        "localId": "112fd2a7-a7ca-40ad-b8eb-b2f4d85831c8"
      }
