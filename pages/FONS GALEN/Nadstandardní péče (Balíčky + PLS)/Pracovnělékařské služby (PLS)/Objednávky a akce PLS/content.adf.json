            "localId": "0ce9c51b29cb"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "99b35620b17d"
              },
              "content": [
                {
                  "text": "Přejděte do části Pracovnelékařské služby → Akce PLS.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "53eaf590683b"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "11fadc9d7d34"
              },
              "content": [
                {
                  "text": "Vyhledejte příslušnou akci pacienta (filtr podle firmy, data nebo stavu).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "bbd7d1ab6c40"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "4dd086675e70"
              },
              "content": [
                {
                  "text": "V detailu akce zkontrolujte pole Vyšetření a Datum návštěvy.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "29660ef4a3b4"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "6b9253614560"
              },
              "content": [
                {
                  "text": "Zkontrolujte Cenu a Způsob úhrady (Hotově / Faktura).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "d67a1202743f"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "b15215e645b7"
              },
              "content": [
                {
                  "text": "Volitelně doplňte Poznámku (max. 1024 znaků).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "135542f1272d"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "4f40a55cdc4c"
              },
              "content": [
                {
                  "text": "Klikněte na Uzavřít akci — zvolte stav Uzavřena, fakturovat nebo Uzavřena, nefakturovat.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "27b277f200ca"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "37f48dca8ac6"
              },
              "content": [
                {
                  "text": "Spusťte funkci Vyúčtování PLS pro hromadnou přípravu faktur za dané období.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "bfae4553d43b"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "3f60e805c53c"
              },
              "content": [
                {
                  "text": "Klikněte na Vystavit fakturu PLS a vyplňte: číslo faktury, datum vystavení, datum plnění, období od/do, typ faktury (Paušál nebo Výkony), identifikaci pacientů, popis.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "3103dc805d7e"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "7335ee41e7bf"
              },
              "content": [
                {
                  "text": "Fakturu vytiskněte přes Tisk vyúčtování PLS.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
