      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "2.1 Vytvoření PLS prohlídky",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "PLS prohlídku zakládáte v okně ",
          "type": "text"
        },
        {
          "text": "Prohlídky a vyšetření",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " kliknutím na ikonu PLS a výběrem příslušné prohlídky přiřazené firmě.",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Ve výběru se zobrazují všechny prohlídky definované na smlouvě (včetně těch z rozšiřujících položek), za těchto podmínek:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Pacient musí být ve stejné skupině PLS jako je prohlídka na smlouvě.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Prohlídka musí být zařazena do sortimentu skupiny ",
                  "type": "text"
                },
                {
                  "text": "Prohlídka",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Je-li prohlídka na smlouvě vícekrát, zobrazí se ve výběru odpovídající počet možností.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "info"
      },
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Objednávka z kalendáře:",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": " Je-li pacient s PLS prohlídkou objednán v kalendáři, zobrazí se na prohlídce ikona s hodinami. Po vytvoření prohlídky se automaticky načtou všechny položky přidané při vytváření objednávky a přenese se reference pracoviště objednávky (na hlavní položku toto neplatí — ta přebírá pracoviště, kde je prohlídka vytvářena). Ikona s hodinami zmizí po vytvoření prohlídky nebo po odebrání objednávky z kalendáře.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "2.2 Práce s položkami na prohlídce",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Na prohlídku lze přidávat nové položky ze smlouvy za těchto podmínek:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Musí se jednat o hlavní položky smlouvy.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Musí vyhovovat filtru věku a pohlaví nastavenému na položce smlouvy.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Navázaný sortiment musí být aktivní a nesmí být ze sortimentu skupiny Prohlídka nebo Služba.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Položka nemusí být ze stejné skupiny PLS jako pacient.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Jsou-li dvě položky shodné (stejný kód sortimentu, cena bez DPH a DPH), nezobrazují se duplicitně.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Defaultně se zobrazují položky bez přiřazené kategorie. Po rozdělení do kategorií lze přidávat i výkony.",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Datum návštěvy",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " nemůže být v budoucnosti. Nelze uzavřít položky prohlídky do období, pro které již existuje vystavená výkonová faktura. Hlavní položka musí být uzavřena jako poslední — jak pořadím, tak datumem.",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Platba za jednotlivé položky:",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " Označte jednu nebo více položek (Ctrl+klik nebo Shift+klik) a použijte tlačítko ",
          "type": "text"
        },
        {
          "text": "Platba výběr",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": ". Systém nabídne výběr platby kartou nebo hotovostí, s volbou tisku příjmového dokladu.",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "2.3 Přiřazení prohlídky jiné ordinaci (IČP)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Prohlídku lze přidělit k provedení externím poskytovatelem pomocí tlačítka s ikonou lékaře (vedle tlačítka Uzavřít). Po výběru ordinace se nabídnou kalendáře navázané na dané IČP a lze vytvořit objednávku s přiřazením na konkrétní PLS prohlídku a položku smlouvy. Akce PLS přejde do stavu ",
          "type": "text"
        },
        {
          "text": "Přiděleno dalšími IČP",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "2.4 Prohlídky podmíněně ovlivňující lhůtu (PPOL)",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Pokud má prohlídka v Designéru nastaveno ",
          "type": "text"
        },
        {
          "text": "Ovlivňuje lhůtu = Podmíněně",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": ", zobrazí se na prohlídce pole ",
          "type": "text"
        },
        {
          "text": "DŮVOD",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " s těmito hodnotami:",
          "type": "text"
        }
      ]
    },
    {
      "type": "bulletList",
      "content": [
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Zdravotní důvod",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "Jiný důvod",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "Hodnota DŮVOD ovlivňuje, zda prohlídka vstoupí do výpočtu intervalu příští prohlídky.",
          "type": "text"
        }
      ]
    },
    {
      "type": "rule"
    },
    {
      "type": "heading",
      "attrs": {
        "level": 2
      },
      "content": [
        {
          "text": "3. PLS očkování — práce v Ordinaci",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3
      },
      "content": [
        {
          "text": "3.1 Vytvoření PLS očkování",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "text": "V okně ",
          "type": "text"
        },
        {
          "text": "Očkování",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " použijte tlačítko ",
          "type": "text"
        },
        {
          "text": "+ PLS",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": " pro zadání očkování vázaného na PLS smlouvu.",
          "type": "text"
        }
      ]
    },
    {
