                    {
                      "text": ". Hodnota null se chová jako Ne. Při volbě ",
                      "type": "text"
                    },
                    {
                      "text": "Podmíněně",
                      "type": "text",
                      "marks": [
                        {
                          "type": "strong"
                        }
