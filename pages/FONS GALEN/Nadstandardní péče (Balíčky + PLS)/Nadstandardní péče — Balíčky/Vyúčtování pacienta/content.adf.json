            {
              "type": "paragraph",
              "attrs": {
                "localId": "5d83b1adc844"
              },
              "content": [
                {
                  "text": "Klikněte na ",
                  "type": "text"
                },
                {
                  "text": "Nový",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "ab4ba98e4206"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "f6d91c128a08"
              },
              "content": [
                {
                  "text": "V dialogu vyberte ",
                  "type": "text"
                },
                {
                  "text": "balíček NP",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ", ze kterého chcete položky vyučtovat.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "9a70e900d3bc"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "ce8b259fde2d"
              },
              "content": [
                {
                  "text": "Systém automaticky načte položky balíčku s cenami z platného ceníku (ke dni vyučtování). U položek s příznakem ",
                  "type": "text"
                },
                {
                  "text": "Plně hrazeno",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": " je cena pro pacienta nulová.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "d99dabb7701b"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "82c88243d76a"
              },
              "content": [
                {
                  "text": "Zkontrolujte seznam položek, jejich počty a ceny.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "d3653ddb671f"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "d79e7c5f9d84"
              },
              "content": [
                {
                  "text": "Zvolte ",
                  "type": "text"
                },
                {
                  "text": "způsob platby",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ": ",
                  "type": "text"
                },
                {
                  "text": "Hotově",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": " nebo ",
                  "type": "text"
                },
                {
                  "text": "Bezhotovostně",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "86d7a8c6f9d5"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "a855fb03b7f8"
              },
              "content": [
                {
                  "text": "Klikněte na ",
                  "type": "text"
                },
                {
                  "text": "Uložit",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
