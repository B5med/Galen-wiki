              "attrs": {
                "localId": "5a28030b618b"
              },
              "content": [
                {
                  "text": "Systém vytvoří opravný záznam s účelem „Storno“. Původní záznam zůstane v historii zachován.",
                  "type": "text"
                }
              ]
            }
          ]
        }
