      },
      "content": [
        {
          "text": "4.6 Vyúčtování pacienta — tvorba závazku NP",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "c48ca78897e8"
      },
      "content": [
        {
          "text": "Tato kapitola popisuje, jak vyučtovat pacientovi položky z balíčku nadstandardní péče a vytvořit závazek. Závazek je finanční pohledávka vůči pacientovi evidovaná v entitě ",
          "type": "text"
        },
        {
          "text": "Galen.Zavazek",
          "type": "text",
          "marks": [
            {
              "type": "code"
            }
          ]
        },
        {
          "text": ".",
          "type": "text"
        }
      ]
    },
    {
      "type": "heading",
      "attrs": {
        "level": 3,
        "localId": "eba16302aa44"
      },
      "content": [
        {
          "text": "4.6.1 Vytvoření nového závazku",
          "type": "text"
        }
      ]
    },
    {
      "type": "orderedList",
      "attrs": {
        "localId": "d8b39c0bb4f3",
        "order": 1
      },
      "content": [
        {
          "type": "listItem",
          "attrs": {
            "localId": "2c734e83e056"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "1698f78a9b25"
              },
              "content": [
                {
                  "text": "Otevřete ",
                  "type": "text"
                },
                {
                  "text": "kartu pacienta",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "8b5d7fc0d726"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "22be377d8642"
              },
              "content": [
                {
                  "text": "Přejděte na záložku ",
                  "type": "text"
                },
                {
                  "text": "Závazky",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
                },
                {
                  "text": ".",
