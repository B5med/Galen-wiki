            {
              "type": "paragraph",
              "attrs": {
                "localId": "86cff9b832bf"
              },
              "content": [
                {
                  "text": "Klikněte na tlačítko ",
                  "type": "text"
                },
                {
                  "text": "Storno",
                  "type": "text",
                  "marks": [
                    {
                      "type": "strong"
                    }
                  ]
