            "localId": "1d0710ade575"
          },
          "content": [
            {
              "text": "Při platbě ",
              "type": "text"
            },
            {
              "text": "Hotově",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": " systém automaticky nabídne tisk ",
              "type": "text"
            },
            {
              "text": "pokladního dokladu (stvrzenky)",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": ". Tisk lze opakovat kdykoliv ze záložky Závazky pomocí tlačítka ",
              "type": "text"
            },
            {
              "text": "Tisk",
              "type": "text",
              "marks": [
                {
                  "type": "strong"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        }
