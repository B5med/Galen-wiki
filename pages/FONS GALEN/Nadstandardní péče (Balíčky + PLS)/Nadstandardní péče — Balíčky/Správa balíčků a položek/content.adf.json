              "attrs": {
                "localId": "5c9f45ace2f1"
              },
              "content": [
                {
                  "text": "Klikněte na Uložit ④ nebo stiskněte Ctrl+S.",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
