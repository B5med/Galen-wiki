              "attrs": {
                "localId": "488e432ec537"
              },
              "content": [
                {
                  "text": "Do pole Název ③ zadejte název balíčku (max. 255 znaků, např. Prémiový balíček 2026).",
                  "type": "text",
                  "marks": [
                    {
                      "type": "em"
                    }
                  ]
                }
