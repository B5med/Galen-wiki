              "attrs": {
                "localId": "f7fadec5f526"
              },
              "content": [
                {
                  "text": "Evidenci závazků pacientů (platba hotově nebo fakturou).",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "81ada51d-3add-4e6a-a969-482a0ecfac4c"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "fb56d3e8ba43"
              },
              "content": [
                {
                  "text": "Nastavení slev a hromadného výdeje na úrovni jednotlivých položek.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "49d19c85-53e5-4fd6-aba3-23411cc615af"
          },
          "content": [
