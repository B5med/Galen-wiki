              "attrs": {
                "localId": "081f579544b7"
              },
              "content": [
                {
                  "text": "Správu ceníku s platností od/do, sazbou DPH a vazbou na pracoviště.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "d3265b10-4a42-4981-8a92-5e0e5f9b1246"
