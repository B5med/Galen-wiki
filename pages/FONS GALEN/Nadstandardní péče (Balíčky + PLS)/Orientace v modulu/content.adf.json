            "localId": "ad01fb99-3a34-4180-8f13-ee258283e350"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "b37e2b9b89bb"
              },
              "content": [
                {
                  "text": "Definici balíčků nadstandardní péče s libovolným počtem položek.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
            "localId": "06ccfa67-b073-4fd1-947c-f5ec4f7cd718"
          },
          "content": [
            {
              "type": "paragraph",
              "attrs": {
                "localId": "ffaac77677e3"
              },
              "content": [
                {
                  "text": "Přiřazení sortimentu (zboží, materiál, administrativa), prohlídek a očkování do balíčků.",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "type": "listItem",
          "attrs": {
