        "localId": "5c26d487514b"
      },
      "content": [
        {
          "text": "Pozor: ",
          "type": "text",
          "marks": [
            {
              "type": "strong"
            }
          ]
        },
        {
          "text": "u bezdrátové verze čtečky po uvedení do továrního nastavení je nutné ji vložit do kolébky a počkat na zvukový signál.",
          "type": "text"
        }
      ]
    },
    {
      "type": "panel",
      "attrs": {
        "panelType": "warning",
