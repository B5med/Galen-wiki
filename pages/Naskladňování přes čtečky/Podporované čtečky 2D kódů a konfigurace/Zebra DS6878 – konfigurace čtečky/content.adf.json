      "content": [
        {
          "text": "Postup nastavení",
          "type": "text"
        }
      ]
    },
    {
      "type": "paragraph",
      "attrs": {
        "localId": "21c4c5a780bf"
      },
      "content": [
        {
          "text": "Pomocí níže přiloženého kódu nastavíme čtečku do továrního nastavení. ",
          "type": "text"
        }
      ]
    },
    {
